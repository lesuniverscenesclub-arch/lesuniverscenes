# Copier ce fichier en ".env.local" (en local) et remplir les mêmes variables dans Vercel.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Adresse publique du site (sert aux liens des emails). En local : http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://universcenes.vercel.app

# "true" = sur téléphone, l'espace membres n'est accessible que depuis l'app installée.
# Mettre "false" pendant les tests si besoin.
NEXT_PUBLIC_EXIGER_INSTALLATION=true

# Médias de la page d'accueil (facultatif)
# ID de la chaîne YouTube (commence par UC…) : affiche automatiquement les dernières vidéos
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/
